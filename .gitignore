# Godot
.godot/
# Build output
build/
dist/
*.log
# OS / editors
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
__pycache__/
# Secrets
.env
.env.*
*.pfx
*.p12
*.pem

# Agent worktrees and personal settings (local only); the project's shared settings are tracked
.claude/*
!.claude/settings.json

# Raw image-workflow sheets (docs/art/prompts; split into assets/ by scripts/art/split_sheets.py)
art_raw/

# The owner's purchased effect packs as downloaded (zips); what the game uses is installed under assets/
newVFX/

# The native library (native/README.md): built by scripts/native/build.sh, not tracked. The build also writes the
# .gdextension (from its .in): a tracked one would make every machine without the library print an import ERROR (CI
# fails on those). The bindings are fetched at the commit native/GODOT_CPP_COMMIT names.
native/bin/
native/godot-cpp/
native/src/*.obj
native/src/*.o
.sconsign*.dblite
native/zd_native.gdextension
native/zd_native.gdextension.uid
