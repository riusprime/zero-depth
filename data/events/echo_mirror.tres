[gd_resource type="Resource" script_class="EventDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/content/defs/event_choice_definition.gd" id="1_ch"]
[ext_resource type="Script" path="res://src/content/defs/event_definition.gd" id="2_ev"]

[sub_resource type="Resource" id="C_gaze"]
script = ExtResource("1_ch")
label_key = &"EVENT_ECHO_MIRROR_GAZE"
cost = &"none"
cost_amount = 0
reward = &"stat_echo"
reward_amount = 0
curse = &"random"

[sub_resource type="Resource" id="C_shatter"]
script = ExtResource("1_ch")
label_key = &"EVENT_ECHO_MIRROR_SHATTER"
cost = &"hp"
cost_amount = 10
reward = &"shards"
reward_amount = 30
curse = &""

[resource]
script = ExtResource("2_ev")
name_key = &"EVENT_ECHO_MIRROR"
desc_key = &"EVENT_ECHO_MIRROR_DESC"
weight = 10
min_floor = 1
requires = &"stat_card"
choices = Array[ExtResource("1_ch")]([SubResource("C_gaze"), SubResource("C_shatter")])
id = &"echo_mirror"
