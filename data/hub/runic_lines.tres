[ext_resource type="Script" path="res://src/content/defs/runic_lines_definition.gd" id="2_def"]

[sub_resource type="Resource" id="L_r1"]
script = ExtResource("1_ent")
id = &"r1"
english = "WHAT SLEEPS BELOW REMEMBERS"

[sub_resource type="Resource" id="L_r2"]
script = ExtResource("1_ent")
id = &"r2"
english = "YOU RETURN AND RETURN"

[sub_resource type="Resource" id="L_r3"]
script = ExtResource("1_ent")
id = &"r3"
english = "PATIENCE IS A KEY"

[sub_resource type="Resource" id="L_r4"]
script = ExtResource("1_ent")
id = &"r4"
english = "UNTOUCHED BY THE DEEP"

[sub_resource type="Resource" id="L_r5"]
script = ExtResource("1_ent")
id = &"r5"
english = "THE STILL ONE SEES"

[sub_resource type="Resource" id="L_r6"]
script = ExtResource("1_ent")
id = &"r6"
english = "THE PIECES CALL TO ONE ANOTHER"

[sub_resource type="Resource" id="L_r7"]
script = ExtResource("1_ent")
id = &"r7"
english = "THE CROWN WAS ALWAYS HOLLOW"

[sub_resource type="Resource" id="L_r8"]
script = ExtResource("1_ent")
id = &"r8"
english = "THE WHEEL TURNS FOR THE PATIENT"

[sub_resource type="Resource" id="L_r9"]
script = ExtResource("1_ent")
id = &"r9"
english = "THE WALLS HIDE WHAT THEY FEAR"

[sub_resource type="Resource" id="L_r10"]
script = ExtResource("1_ent")
id = &"r10"
english = "EVERY TONGUE ONE RUNE"

[resource]
script = ExtResource("2_def")
id = &"main"
lines = Array[ExtResource("1_ent")]([SubResource("L_r1"), SubResource("L_r2"), SubResource("L_r3"), SubResource("L_r4"), SubResource("L_r5"), SubResource("L_r6"), SubResource("L_r7"), SubResource("L_r8"), SubResource("L_r9"), SubResource("L_r10")])
